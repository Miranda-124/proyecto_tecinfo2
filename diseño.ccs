body {
    background-color: #e0f7fa;
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
}

marquee {
    background-color: #006064;
    color: white;
    padding: 12px;
    font-weight: bold;
    font-size: 18px;
}

nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    background-color: #00838f;
    display: flex;
    justify-content: space-around;
}

nav ul li a {
    color: white;
    text-decoration: none;
    padding: 15px 20px;
    display: block;
}

nav ul li a:hover {
    background-color: #004d40;
}

header {
    text-align: center;
    padding: 30px;
}

header h1 {
    font-size: 36px;
    color: #004d40;
}

header img {
    width: 300px;
    height: auto;
    margin-top: 20px;
    border-radius: 12px;
}

.informacion {
    background-color: #b2ebf2;
    padding: 20px;
    margin: 20px;
    border-radius: 10px;
    font-size: 18px;
}

button {
    display: block;
    margin: 30px auto;
    padding: 12px 24px;
    font-size: 16px;
    background-color: #00796b;
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background-color 0.3s;
}

button:hover {
    background-color: #004d40;
}
